{
	"name": "cozynet",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"client:dev": "NODE_ENV=development vite",
		"server:dev": "NODE_ENV=development tsx watch src/server.tsx",
		"server:start": "NODE_ENV=production tsx src/server.tsx",
		"dev": "concurrently \"pnpm client:dev\" \"pnpm server:dev\"",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "node -v"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@hono/vite-dev-server": "0.26.1",
		"@hono/zod-validator": "0.9.1",
