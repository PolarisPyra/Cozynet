		"@marsidev/react-turnstile": "1.6.3",
		"@radix-ui/react-accordion": "^1.3.1",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-aspect-ratio": "^1.2.0",
		"@radix-ui/react-avatar": "1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-context-menu": "^2.4.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-hover-card": "^1.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-menubar": "^1.2.1",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-select": "2.4.1",
		"@radix-ui/react-separator": "1.2.0",
		"@radix-ui/react-slider": "^1.6.1",
		"@radix-ui/react-slot": "1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toggle": "^1.2.1",
		"@radix-ui/react-toggle-group": "^1.2.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"@tailwindcss/postcss": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-query-devtools": "5.104.5",
		"@tanstack/react-virtual": "^3.14.21",
		"@types/luxon": "^3.7.6",
		"aes-js": "^3.1.2",
		"argon2": "0.45.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.4.0",
		"date-fns-tz": "3.2.0",
		"dotenv": "18.0.8",
		"embla-carousel-react": "^8.6.0",
		"fflate": "^0.8.3",
		"hono": "4.13.13",
		"hono-rate-limiter": "0.5.4",
		"html-to-image": "1.11.13",
		"input-otp": "^1.5.0",
		"lucide-react": "1.61.0",
		"luxon": "^3.7.2",
		"mysql2": "^3.24.6",
		"next-themes": "0.4.6",
		"path": "0.12.7",
		"react": "19.3.1",
		"react-colorful": "^5.8.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "19.3.1",
		"react-hook-form": "^7.90.0",
		"react-resizable-panels": "^4.14.8",
		"react-router-dom": "7.18.4",
		"recharts": "3.10.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"tailwindcss-animate": "1.0.7",
		"three": "^0.186.1",
		"vaul": "^1.1.2",
		"victory": "^37.3.6",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@plugin-web-update-notification/vite": "2.1.3",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@types/aes-js": "^3.1.4",
		"@types/node": "^26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "6.1.2",
		"autoprefixer": "10.6.1",
		"concurrently": "10.0.6",
		"eslint": "^10.13.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "17.13.0",
		"postcss": "8.5.31",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"ts-node": "10.9.2",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5"
	},
	"packageManager": "pnpm@10.18.0",
	"prettier": {
		"semi": false,
		"singleQuote": false,
		"printWidth": 120,
		"tabWidth": 2,
		"useTabs": true,
		"quoteProps": "as-needed",
		"jsxSingleQuote": false,
		"bracketSpacing": true,
		"bracketSameLine": false,
		"arrowParens": "avoid",
		"endOfLine": "lf",
		"trailingComma": "none",
		"plugins": [
			"@trivago/prettier-plugin-sort-imports",
			"prettier-plugin-tailwindcss"
		],
		"importOrder": [
			"^(react|next?/?([a-zA-Z/]*))$",
			"<THIRD_PARTY_MODULES>",
			"^@/(.*)$",
			"^[./]"
		],
		"importOrderSeparation": true,
		"importOrderSortSpecifiers": true
	}
}
